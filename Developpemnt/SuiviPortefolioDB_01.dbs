<?xml version="1.0" encoding="UTF-8" ?>
<project name="Sqlite" database="Sqlite" id="20c8941a-7668-47c0-98da-d07ced524b12" >
	<schema name="Default" >
		<table name="Actif" spec="" >
			<column name="ActifId" prior="Id" type="INTEGER" mandatory="y" >
				<identity><![CDATA[AUTOINCREMENT]]></identity>
			</column>
			<column name="ActifNom" prior="NomActif" type="TEXT" mandatory="y" />
			<column name="ActifTicker" prior="Ticker" type="TEXT" mandatory="y" />
			<column name="ActifIsin" prior="Isin" type="TEXT" mandatory="y" />
			<column name="ActifMarche" prior="Marche" type="TEXT" mandatory="y" />
			<column name="ActifDevise" prior="Devise" type="TEXT" mandatory="y" />
			<column name="ActifCoursActuel" prior="CoursActuel" type="DECIMAL" length="18" decimal="2" mandatory="y" />
			<column name="ActifDateDernierCours" prior="DateDernierCours" type="DATETIME" mandatory="y" />
			<column name="ActifTransId" type="INT" />
			<index name="pk_Actif" unique="PRIMARY_KEY" >
				<column name="ActifId" />
			</index>
			<fk name="fk_Actif" to_schema="Default" to_table="TransacFin" >
				<fk_column name="ActifTransId" pk="TransId" />
			</fk>
		</table>
		<table name="Compte" spec="" >
			<column name="CpteId" prior="CompteId" type="INTEGER" mandatory="y" >
				<identity><![CDATA[AUTOINCREMENT]]></identity>
			</column>
			<column name="CpteNom" prior="CompteNom" type="TEXT" mandatory="y" />
			<column name="CpteDevise" prior="CompteDevise" type="TEXT" mandatory="y" />
			<column name="CpteSoldeEsp" prior="CpteSoldeEspeces" type="DECIMAL" length="18" mandatory="y" />
			<column name="CptePtfId" prior="ComptePortefeuilleId" type="INT" mandatory="y" />
			<column name="CpteSoldeTick" prior="CompteSoldeTickers" type="DECIMAL" length="18" />
			<index name="pk_Compte" unique="PRIMARY_KEY" >
				<column name="CpteId" />
			</index>
			<fk name="FK_Compte Portefeuille" to_schema="Default" to_table="Portefeuille" options="" >
				<fk_column name="CptePtfId" pk="PtfId" />
			</fk>
		</table>
		<table name="Dividende" spec="" >
			<column name="DvdId" prior="Id" type="INTEGER" mandatory="y" >
				<identity><![CDATA[AUTOINCREMENT]]></identity>
			</column>
			<column name="DvdMontant" prior="MontantDividende" type="DECIMAL" length="18" mandatory="y" />
			<column name="DvdDate" prior="DateDividende" type="DATETIME" mandatory="y" />
			<column name="DvdActifId" prior="ActifId" type="INTEGER" mandatory="y" />
			<column name="DvdSolde" prior="SoldeDividende" type="DECIMAL" length="18" mandatory="y" />
			<index name="pk_Dividende" unique="PRIMARY_KEY" >
				<column name="DvdId" />
			</index>
			<fk name="FK_Dividende Actif" to_schema="Default" to_table="Actif" options="" >
				<fk_column name="DvdActifId" pk="ActifId" />
			</fk>
		</table>
		<table name="ETF" spec="" >
			<column name="ActifEtfId" prior="Id" type="INTEGER" mandatory="y" >
				<identity><![CDATA[AUTOINCREMENT]]></identity>
			</column>
			<column name="ActiEtfNom" prior="NomETF" type="TEXT" mandatory="y" />
			<column name="ActifEtfIndiceSuivi" prior="IndiceSuivi" type="TEXT" mandatory="y" />
			<column name="ActifEtfCapit" prior="Capitalisant" type="NUMERIC" mandatory="y" />
			<column name="ActiEtfFraisGestion" prior="FraisGestion" type="DECIMAL" length="5" mandatory="y" />
			<index name="pk_ETF" unique="PRIMARY_KEY" >
				<column name="ActifEtfId" />
			</index>
			<fk name="FK_ETF Actif" to_schema="Default" to_table="Actif" options="" >
				<fk_column name="ActifEtfId" pk="ActifId" />
			</fk>
		</table>
		<table name="Liquidite" spec="" >
			<column name="LiqId" prior="Id" type="INTEGER" mandatory="y" >
				<identity><![CDATA[AUTOINCREMENT]]></identity>
			</column>
			<column name="LiqCpteId" prior="TypeLiquidite" type="TEXT" mandatory="y" />
			<column name="LiqDevise" prior="Devise" type="TEXT" mandatory="y" />
			<column name="LiqSolde" prior="SoldeLiquidite" type="DECIMAL" length="18" mandatory="y" />
			<column name="LiqDateMvt" prior="DateMouvementLiquidite" type="DATETIME" mandatory="y" />
			<index name="pk_Liquidite" unique="PRIMARY_KEY" >
				<column name="LiqId" />
			</index>
			<fk name="FK_Liquidite Compte" to_schema="Default" to_table="Compte" options="" >
				<fk_column name="LiqCpteId" pk="CpteId" />
			</fk>
		</table>
		<table name="MouvementTresorerie" spec="" >
			<column name="MvtTresId" prior="Id" type="INTEGER" mandatory="y" >
				<identity><![CDATA[AUTOINCREMENT]]></identity>
			</column>
			<column name="MvtType" prior="TypeMouvement" type="TEXT" mandatory="y" />
			<column name="MvtMontant" prior="MontantMouvement" type="DECIMAL" length="18" mandatory="y" />
			<column name="MvtDate" prior="DateMouvement" type="DATETIME" mandatory="y" />
			<column name="MvtCpteId" prior="CompteId" type="INT" mandatory="y" />
			<index name="pk_MouvementTresorerie" unique="PRIMARY_KEY" >
				<column name="MvtTresId" />
			</index>
			<fk name="FK_MouvementTresorerie Compte" to_schema="Default" to_table="Compte" options="" >
				<fk_column name="MvtCpteId" pk="CpteId" />
			</fk>
		</table>
		<table name="Portefeuille" spec="" >
			<column name="PtfId" prior="Id" type="INTEGER" mandatory="y" >
				<identity><![CDATA[AUTOINCREMENT]]></identity>
			</column>
			<column name="PtfNom" prior="NomPortefeuille" type="TEXT" mandatory="y" />
			<column name="PtfSolde" prior="Solde" type="DECIMAL" >
				<defo><![CDATA[0]]></defo>
			</column>
			<column name="PtfEstDefaut" prior="EstDefaut" type="INTEGER" >
				<defo><![CDATA[0]]></defo>
			</column>
			<index name="pk_Portefeuille" unique="PRIMARY_KEY" >
				<column name="PtfId" />
			</index>
		</table>
		<table name="Position" spec="" >
			<column name="PosId" prior="Id" type="INTEGER" mandatory="y" >
				<identity><![CDATA[AUTOINCREMENT]]></identity>
			</column>
			<column name="PosActifId" prior="ActifId" type="INTEGER" mandatory="y" />
			<column name="PosQte" prior="Quantité" type="DECIMAL" mandatory="y" />
			<column name="PosPrixMoyen" prior="PrixMoyen" type="DECIMAL" mandatory="y" />
			<index name="pk_Position" unique="PRIMARY_KEY" >
				<column name="PosId" />
			</index>
			<fk name="fk_Position" to_schema="Default" to_table="Actif" >
				<fk_column name="PosActifId" pk="ActifId" />
			</fk>
		</table>
		<table name="TransacFin" spec="" >
			<column name="TransId" prior="Id" type="INTEGER" mandatory="y" >
				<identity><![CDATA[AUTOINCREMENT]]></identity>
			</column>
			<column name="TransType" prior="TransTransType" type="TEXT" mandatory="y" />
			<column name="TransQte" prior="Quantite" type="DECIMAL" length="18" mandatory="y" >
				<comment><![CDATA[Quantite]]></comment>
			</column>
			<column name="TransDateTransac" prior="DateTransacFin" type="DATETIME" mandatory="y" />
			<column name="TransCpteId" prior="ActifId" type="INT" mandatory="y" />
			<index name="pk_TransacFin" unique="PRIMARY_KEY" >
				<column name="TransId" />
			</index>
			<fk name="fk_TransacFin" to_schema="Default" to_table="Compte" >
				<fk_column name="TransCpteId" pk="CpteId" />
			</fk>
		</table>
	</schema>
