<Window x:Class="SuiviPortefolio.Transactions.TransView.TransEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recherche d'une cotation"
        Width="600"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="160"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            

        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="Rechercher une cotation"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1" Text="Nom :" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox x:Name="NomTextBox" Width="160" VerticalContentAlignment="Center"
                     KeyDown="NomTextBox_KeyDown"/>
            <Button Content="Rechercher" Width="95" Margin="8,0,0,0"
                    Click="Rechercher_Click"/>
        </StackPanel>

        <ListBox x:Name="ResultatsListBox" Grid.Row="2" Grid.ColumnSpan="2"
                 SelectionChanged="ResultatsListBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Symbol}" FontWeight="Bold" Width="100"/>
                        <TextBlock Text="{Binding Name}" Width="330"/>
                        <TextBlock Text="{Binding Instrument}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="3" Text="Symbole :" VerticalAlignment="Center" Margin="0,8,10,8"/>
        <TextBox x:Name="SymbolTextBox" Grid.Row="3" Grid.Column="1" IsReadOnly="True"
                 Margin="0,8,0,8"/>

        <TextBlock Grid.Row="4" Text="Instrument :" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox x:Name="InstrumentTextBox" Grid.Row="4" Grid.Column="1" IsReadOnly="True"
                 Margin="0,0,0,8"/>

        <TextBlock Grid.Row="5" Text="Marché :" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox x:Name="MarcheTextBox" Grid.Row="5" Grid.Column="1" IsReadOnly="True"
                 Margin="0,0,0,8"/>

        <TextBlock Grid.Row="6" Text="Devise :" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox x:Name="DeviseTextBox" Grid.Row="6" Grid.Column="1" IsReadOnly="True"
                 Margin="0,0,0,8"/>

        <TextBlock Grid.Row="7" Text="Cours de clôture :" VerticalAlignment="Center" Margin="0,0,10,8"/>
        <TextBox x:Name="CloseTextBox" Grid.Row="7" Grid.Column="1" IsReadOnly="True"
                 Margin="0,0,0,8"/>

        <TextBlock Grid.Row="8" Text="Date du cours :" VerticalAlignment="Center" Margin="0,0,10,15"/>
        <TextBox x:Name="DateTextBox" Grid.Row="8" Grid.Column="1" IsReadOnly="True"
                 Margin="0,0,0,15"/>

        <StackPanel Grid.Row="9" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" IsCancel="True" Width="90" Margin="0,0,8,0"/>
            <Button Content="Utiliser cette cotation" IsDefault="True" Width="150"
                    Click="Utiliser_Click"/>
        </StackPanel>
    </Grid>
</Window>
