<UserControl x:Class="SuiviPortefolio.Transactions.MouvementView.MouvementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Grid.Row="0" Text="MOUVEMENTS D'ESPÈCES" Style="{DynamicResource TitleH1Style}" Margin="0,0,0,10"/>

        <!-- Formulaire de saisie -->
        <GroupBox Grid.Row="1" Header="Nouveau mouvement" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Type de mouvement -->
                <TextBlock Text="Type :" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding TypesMouvement}"
                          SelectedItem="{Binding TypeMouvement, Mode=TwoWay}" Margin="0,0,0,8">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Compte -->
                <TextBlock Grid.Row="1" Text="Compte :" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Comptes}"
                          SelectedItem="{Binding CompteSelectionne, Mode=TwoWay}" Margin="0,0,0,8">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CpteNom}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Compte destination (visible uniquement pour les virements) -->
                <TextBlock Grid.Row="2" Text="Vers compte :" VerticalAlignment="Center" Margin="0,0,8,8">
                    <TextBlock.Visibility>
                        <Binding Path="TypeMouvement" Converter="{StaticResource TypeMouvementToVisibilityConverter}" ConverterParameter="Virement"/>
                    </TextBlock.Visibility>
                </TextBlock>
                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Comptes}"
                          SelectedItem="{Binding CompteDestination, Mode=TwoWay}" Margin="0,0,0,8"
                          Visibility="{Binding TypeMouvement, Converter={StaticResource TypeMouvementToVisibilityConverter}, ConverterParameter=Virement}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CpteNom}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Montant -->
                <TextBlock Grid.Row="3" Text="Montant :" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MontantTexte, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                <!-- Date -->
                <TextBlock Grid.Row="4" Text="Date :" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <DatePicker Grid.Row="4" Grid.Column="1" SelectedDate="{Binding DateMouvement, Mode=TwoWay}" Margin="0,0,0,8"/>

                <!-- Description -->
                <TextBlock Grid.Row="5" Text="Description :" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Description, Mode=TwoWay}" Margin="0,0,0,0"/>
            </Grid>
        </GroupBox>

        <!-- Liste des mouvements -->
        <GroupBox Grid.Row="2" Header="Historique des mouvements" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <DataGrid ItemsSource="{Binding Mouvements}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          RowStyle="{DynamicResource DataGridThemeStyle}" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" SelectedItem="{Binding MouvementSelectionne, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding MouvDate, StringFormat=dd-MM-yyyy}" Width="*"
                                            SortMemberPath="MouvDate" SortDirection="Descending"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding MouvType}" Width="*"/>
                        <DataGridTextColumn Header="Compte" Binding="{Binding CompteNom}" Width="*"/>
                        <DataGridTextColumn Header="Vers compte" Binding="{Binding CompteDestNom}" Width="*"/>
                        <DataGridTextColumn Header="Montant" Binding="{Binding MouvMontant, StringFormat={}{0:N2}}" Width="*"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding MouvDescription}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- Boutons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" Command="{Binding AnnulerCommand}" Width="90" Margin="0,0,8,0"/>
            <Button Content="Enregistrer" Command="{Binding EnregistrerCommand}" Width="100" Margin="0,0,8,0"/>
            <Button Content="Supprimer" Command="{Binding SupprimerCommand}" Width="100"/>
        </StackPanel>
    </Grid>
</UserControl>
