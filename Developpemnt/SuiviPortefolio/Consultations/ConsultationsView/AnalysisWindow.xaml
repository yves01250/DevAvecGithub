<!-- Views/AnalysisWindow.xaml -->
<Window x:Class="SuiviPortefolio.Consultations.ConsultationsView.AnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="Analyse de la sélection"
        Height="400" Width="700"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid Background="{DynamicResource WindowBackgroundBrush}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Stats simples -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding Count, StringFormat='Nombre de tickers : {0}'}"
                       FontSize="14" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding TotalValue, StringFormat='Valeur totale : {0:N2}'}"
                       FontSize="14" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding AvgPrice, StringFormat='Cours moyen : {0:N2}'}"
                       FontSize="14" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding TypesSummary, StringFormat='Répartition par type : {0}'}"
                       FontSize="14"/>
        </StackPanel>

        <!-- Liste des tickers sélectionnés -->
        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}"

            BorderThickness="1"
            CornerRadius="4"
            Padding="1"
            Background="{DynamicResource WindowBackgroundBrush}"
            ClipToBounds="True">                  

            <DataGrid Grid.Row="1"
                  RowStyle="{StaticResource DataGridThemeStyle}"
                  ItemsSource="{Binding SelectedPositions}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                
                    BorderThickness="0"
                    HeadersVisibility="Column"
                    
                    GridLinesVisibility="All"
                    HorizontalGridLinesBrush="LightBlue"
                    VerticalGridLinesBrush="LightBlue" >
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"
                                Value="{DynamicResource DataGridHeaderBackgroundBrush}" />

                        <Setter Property="Foreground"
                                Value="{DynamicResource DataGridHeaderForegroundBrush}" />

                        <Setter Property="BorderBrush"
                                Value="{DynamicResource DataGridHeaderBorderBrush}" />

                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="Height" Value="32" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ticker" Binding="{Binding Ticker}" />
                    <DataGridTextColumn Header="Type"   Binding="{Binding Type}" />
                    <DataGridTextColumn Header="Qté"    Binding="{Binding Quantity, StringFormat=N2}" />
                    <DataGridTextColumn Header="Cours"  Binding="{Binding Price, StringFormat=N2}" />
                    <DataGridTextColumn Header="Valeur" Binding="{Binding Value, StringFormat=N2}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>