<Window x:Class="SuiviPortefolio.Portefeuille.PortefeuilleView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SuiviPortefolio"
        xmlns:compte="clr-namespace:SuiviPortefolio.Comptes.CompteView"
        xmlns:transaction="clr-namespace:SuiviPortefolio.Transactions.TransView"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="1000">
        <!-- A remplacer pour fenêtre s'adaptant à l'ecran-->
        <!-- Title="MainWindow" WindowState="Maximized"> -->

        <!-- Définition du WindowChrome pour personnaliser la barre de titre -->
    <!-- <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="30"
            ResizeBorderThickness="5"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome> -->

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        
        
        <Grid.RowDefinitions>
            <!-- Ligne pour le bouton -->
            <RowDefinition Height="Auto" />
            <!-- Ligne pour le TabControl -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
                <!-- Bouton pour basculer entre les thèmes -->
        <Button Grid.Row="0"                
                Content="🌓 Basculer en mode sombre"
                Click="ToggleTheme_Click"
                HorizontalAlignment="Right"
                Margin="10" />
       

        <!-- Onglets sur toute la largeur -->
        <TabControl Margin="0" Padding="0"
                SelectionChanged="TabControl_SelectionChanged"
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2">

            <TabItem Header="Portefeuille">
                <!--<"Contenu de l'onglet 1"/> -->
                <Grid Margin="10">
                    <StackPanel>
                        <TextBlock Text="PORTEFEUILLES" Style="{DynamicResource TitleH1Style}" Margin="0,0,0,10"/>

                        <ComboBox ItemsSource="{Binding ListePortefeuilles}"
                                SelectedItem="{Binding PortefeuilleSelectionne, Mode=TwoWay}"
                                Margin="0,5,0,10">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PtfNom}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Content="Ajouter un portefeuille"
                                Command="{Binding }"
                                Width="220"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,10"/>

                        <Button Content="Définir comme portefeuille par défaut"
                                Command="{Binding }"
                                Width="220"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,10"/>

                        <GroupBox Header="Portefeuille sélectionné" Margin="0,10,0,0">
                            <StackPanel Margin="10">
                                <TextBlock 
                                    Text="{Binding Portefeuille.PtfNom, Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Solde :" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Portefeuille.PtfSolde, StringFormat='{}{0:F2}'}" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Grid>    
            </TabItem>

            <TabItem x:Name="ComptesTab" Header="Comptes">
                <!--<local:CompteView />-->
                <compte:CompteView x:Name="ComptesView" />
            </TabItem>

            <TabItem Header="Transactions">
                <transaction:TransView/>
            </TabItem>

        </TabControl>        
    </Grid>
</Window>
