<Window x:Class="SuiviPortefolio.Portefeuille.PortefeuilleView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SuiviPortefolio"
        xmlns:compte="clr-namespace:SuiviPortefolio.Comptes.CompteView"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Onglets sur toute la largeur -->
        <TabControl Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2">

            <TabItem Header="Portefeuille">
                <!--<TextBlock Text="Contenu de l'onglet 1"/> -->
            </TabItem>

            <TabItem Header="Comptes">
                <!--<local:CompteView />-->
                <compte:CompteView />

            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="1" Grid.Column="0">
            <TextBlock Text="Bonjour depuis le sous-répertoire Portefeuille/PortefeuilleView/ !" />
            <TextBlock Text="PORTEFEUILLE" />

            <!-- Choix du portefeuille par défaut -->
            <TextBlock Text="Portefeuille par défaut :" Margin="0,10,0,0"/>
            <ComboBox ItemsSource="{Binding ListePortefeuilles}"
              SelectedItem="{Binding PortefeuilleSelectionne, Mode=TwoWay}"
              DisplayMemberPath="PtfNom"
              Margin="0,5,0,10" />

            <TextBlock Background="LightYellow"
             Text="{Binding Portefeuille.PtfNom, Mode=TwoWay,
                            UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center">
                <TextBlock Text="Solde:"
                   Margin="0,5,10,0"
                   Width="80" />
                <TextBlock Text="{Binding Portefeuille.PtfSolde, Mode=TwoWay,
                                  UpdateSourceTrigger=PropertyChanged}"
                   Margin="0,5,0,0"
                   Width="100" />
            </StackPanel>
        </StackPanel>


        <StackPanel Grid.Row="2" Grid.Column="0" > 

                 <!-- Ligne de séparation -->
                <Separator Margin="0,10,0,10"
                    Background="Red"
                    Height="1" />

            <TextBlock Text="AJOUTER" />

            <!-- Les derniers TextBox sur la même ligne -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Enregistrer"
                            Click="Enregistrer_Click"
                            Width="120"
                            Margin="5" />

                    <TextBlock Text="Nom:"
                            Margin="0,5,10,0"
                            Width="80" />
                   <TextBox Text="{Binding Portefeuille.PtfNom, Mode=TwoWay,
                        UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,5,0,0"
                            Width="200" />
                </StackPanel>

                <!-- Les derniers TextBox sur la même ligne -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="Montant:"
                            Margin="0,5,10,0"
                            Width="80" />
                   <TextBox Text="{Binding Portefeuille.PtfSolde, Mode=TwoWay,
                        UpdateSourceTrigger=PropertyChanged}"
                            Margin="0,5,0,0"
                            Width="100" />
                </StackPanel>

        </StackPanel>
        
    </Grid>
</Window>
