<UserControl x:Class="SuiviPortefolio.Comptes.CompteView.CompteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
             
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="COMPTES" Style="{DynamicResource TitleH1Style}" Margin="0,0,0,10"/>

        <ComboBox Grid.Row="1" ItemsSource="{Binding Comptes}"
                      SelectedItem="{Binding CompteSelectionne, Mode=TwoWay}"
                      Margin="0,0,0,10">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding CpteNom}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
            <Button Content="Ajouter un compte"
                    Command="{Binding AjouterCompteCommand}"
                    Width="160"
                    HorizontalAlignment="Left"/>

            <Button Content="Modifier le compte sélectionné"
                    Command="{Binding ModifierCompteCommand}"
                    Width="220"
                    HorizontalAlignment="Left"/>

            <Button Content="Définir comme compte par défaut"
                    Command="{Binding SetCompteDefautCommand}"
                    Width="220"
                    HorizontalAlignment="Left"/>

            <Button Content="Actualiser les estimations"
                    Command="{Binding ActualiserValorisationsCommand}"
                    HorizontalAlignment="Left"/>
        </WrapPanel>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding ValorisationComptes}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  RowStyle="{DynamicResource DataGridThemeStyle}"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Margin="0,0,0,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Compte" Binding="{Binding CpteNom}" Width="2*"/>
                <DataGridTextColumn Header="Type" Binding="{Binding CpteType}" Width="*"/>
                <DataGridTextColumn Header="Devise" Binding="{Binding CpteDevise}" Width="*"/>
                <DataGridTextColumn Header="Espèces" Binding="{Binding SoldeEspeces, StringFormat={}{0:N2}}" Width="*"/>
                <DataGridTextColumn Header="Actions (derniers cours)" Binding="{Binding ValorisationActions, StringFormat={}{0:N2}}" Width="1.5*"/>
                <DataGridTextColumn Header="Total estimé" Binding="{Binding SoldeTotal, StringFormat={}{0:N2}}" Width="*"/>
                <DataGridTextColumn Header="État" Binding="{Binding Statut}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4"
                   Text="{Binding ValorisationStatus}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"/>
    </Grid>
</UserControl>
