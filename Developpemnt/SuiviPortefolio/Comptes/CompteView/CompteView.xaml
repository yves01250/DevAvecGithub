<UserControl x:Class="SuiviPortefolio.Comptes.CompteView.CompteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="COMPTES" FontWeight="Bold" FontSize="20" Margin="0,0,0,10"/>

            <ComboBox ItemsSource="{Binding Comptes}"
                      SelectedItem="{Binding CompteSelectionne, Mode=TwoWay}"
                      DisplayMemberPath="CpteNom"
                      Margin="0,0,0,10"/>

            <Button Content="Ajouter un compte"
                    Command="{Binding AjouterCompteCommand}"
                    Width="160"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,10"/>

            <Button Content="Modifier le compte sélectionné"
                    Command="{Binding ModifierCompteCommand}"
                    Width="220"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,10"/>

            <Button Content="Définir comme compte par défaut"
                    Command="{Binding SetCompteDefautCommand}"
                    Width="220"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,10"/>

            <GroupBox Header="Compte sélectionné" Margin="0,10,0,0">
                <StackPanel Margin="10">
                    <TextBlock Text="Nom :" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CompteSelectionne.CpteNom}" Margin="0,0,0,5"/>

                    <TextBlock Text="Type :" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CompteSelectionne.CpteType}" Margin="0,0,0,5"/>

                    <TextBlock Text="Solde :" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CompteSelectionne.CpteSolde}" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Grid>
</UserControl>
